{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["DOM", "DOM.Iterable", "ES2023"],
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "allowJs": true,
        "incremental": true
    },
    "include": [
        "next-env.d.ts",
        "app/**/*.ts",
        "app/**/*.tsx",
        "lib/**/*.ts",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        ".next-gallery-test/types/**/*.ts",
        ".next-gallery-test/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
