        "test:data-sources": "node --test tests/dataSourceDetails.test.mjs tests/bottomSheetSelect.test.mjs",
        "test:homes": "node --test tests/homeList.test.mjs tests/joinHomeForm.test.mjs tests/homeForm.test.mjs tests/locationMapPicker.test.mjs",
