{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "tabWidth": 4,
    "bracketSameLine": true,
    "endOfLine": "lf",
    "ignorePatterns": [
        "**/.next/**",
        "**/.next-gallery-test/**",
        "tools/expo-visual-review/next-env.d.ts",
        ".expo/**",
        "android/**",
        "node_modules/**",
        "dist/**",
        "build/**",
        "*.config.js",
        "*.config.cjs"
    ]
}
